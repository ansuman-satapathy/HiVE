DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quickdesk
# Generate a strong random key before deploying: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Optional dedicated key for encrypting API keys in Postgres (defaults to deriving from SECRET_KEY)
# CONFIG_ENCRYPTION_KEY=

# Optional: Default LLM via environment (any OpenAI-compatible provider: ollama, openai, nvidia, custom)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=

# Embeddings: "auto" / "local" (384d offline), or "ollama" / "openai" / "nvidia" / "custom"
EMBEDDING_PROVIDER=auto
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=
# EMBEDDING_API_KEY=

# Reranker mode: "local" (fast offline cross-scorer, recommended) or "nvidia"
RERANKER_PROVIDER=local

