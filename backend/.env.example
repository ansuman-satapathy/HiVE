DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quickdesk
# Generate a strong random key before deploying: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Optional dedicated key for encrypting API keys in Postgres (defaults to deriving from SECRET_KEY)
# CONFIG_ENCRYPTION_KEY=

# Optional: NVIDIA NIM API configuration (leave commented out for 100% local/Ollama mode)
# NVIDIA_API_KEY=nvapi-your-key-here
# NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
# NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Provider mode: "auto" (uses local 384d embeddings unless NVIDIA_API_KEY is set) or "local"
EMBEDDING_PROVIDER=auto

# Reranker mode: "local" (fast cross-scorer, recommended) or "nvidia"
RERANKER_PROVIDER=local
# NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2

