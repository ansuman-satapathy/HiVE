DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quickdesk
SECRET_KEY=generate-a-strong-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# NVIDIA NIM API configuration (free endpoints from https://build.nvidia.com/explore/discover)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Provider mode: "auto" (uses NVIDIA NIM with local fallback) or "local" (fast offline embeddings)
EMBEDDING_PROVIDER=auto

# Reranker mode: "local" (fast cross-scorer, recommended) or "nvidia" (if dedicated NIM endpoint configured)
RERANKER_PROVIDER=local
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2

